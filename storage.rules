rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Level Administrator has full privileges across Firebase Storage
    function isTopAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
          request.auth.token.email.lower() == 'karina.brdar@gmail.com'
        )) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Submissions directory: public upload with strict size and type validation
    match /submissions/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 500 * 1024 * 1024
                    && (request.resource.contentType.matches('video/.*')
                        || request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow update, delete: if isTopAdmin();
    }

    // Festival Archive, Photos & Posters: public read, admin write & delete
    match /archive/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    match /archive_photos/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    match /archive_videos/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    match /posters/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    // Default: public read, top admin write & delete
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }
  }
}
