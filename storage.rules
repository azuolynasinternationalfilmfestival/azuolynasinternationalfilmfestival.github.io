rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Level Administrator has full privileges across Firebase Storage
    function isTopAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
          request.auth.token.email.lower() == 'karina.brdar@gmail.com'
        )) ||
        (firestore.exists(/databases/ai-studio-azuolynasinterna-cd7ce36e-5213-4751-8aa0-a7141d397a83/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/ai-studio-azuolynasinterna-cd7ce36e-5213-4751-8aa0-a7141d397a83/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Submissions directory: public upload with format validation (any file size)
    match /submissions/{fileName} {
      allow read: if true;
      allow create: if request.resource.size > 0
                    && (request.resource.contentType.matches('video/(mp4|quicktime|webm)')
                        || request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow update, delete: if isTopAdmin();
    }

    // Unified Content Media (covers & edition galleries): public read, admin/signed-in write & delete
    match /content/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    // Festival Archive, Photos & Posters: public read, admin write & delete
    match /archive/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    match /archive_photos/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    match /archive_videos/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }

    // Movie Media & Posters: public read, authenticated admin write & delete
    match /movies/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin();
    }

    // Posters: public read, admin write & delete
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin();
    }

    // Default: public read, top admin write & delete
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if isTopAdmin() || isSignedIn();
    }
  }
}
