{
  "entities": {
    "FestivalSettings": {
      "title": "FestivalSettings",
      "description": "Global festival settings, tab visibilities, and localized controls",
      "type": "object",
      "properties": {
        "showAbout": { "type": "boolean", "description": "Visibility of About tab & hero" },
        "showTerms": { "type": "boolean", "description": "Visibility of Terms & rules tab" },
        "showFaq": { "type": "boolean", "description": "Visibility of FAQ tab" },
        "showCategories": { "type": "boolean", "description": "Visibility of Categories & prizes tab" },
        "showEditions": { "type": "boolean", "description": "Visibility of Editions tab" },
        "showArchive": { "type": "boolean", "description": "Visibility of Archive tab" },
        "archiveVisibility": { "type": "boolean", "description": "Global archive visibility tumbler" },
        "showCurrentEdition": { "type": "boolean", "description": "Visibility of featured FEST edition link" },
        "showResults": { "type": "boolean", "description": "Visibility of Results & winners tab" },
        "showVoting": { "type": "boolean", "description": "Visibility of Voting tab" },
        "votingActive": { "type": "boolean", "description": "Whether voting is active or closed" },
        "showScreening": { "type": "boolean", "description": "Visibility of Screening tab" },
        "showSubmit": { "type": "boolean", "description": "Visibility of Submission form tab" },
        "maintenanceMode": { "type": "boolean", "description": "Whether maintenance mode is active" },
        "recordingVideoUrl": { "type": "string", "description": "URL of the festival recording video" },
        "prizesPhotoUrl": { "type": "string", "description": "URL of the prizes photo" }
      }
    },
    "FestivalEdition": {
      "title": "FestivalEdition",
      "description": "Information about a specific annual edition of the festival",
      "type": "object",
      "properties": {
        "year": { "type": "string", "description": "Edition year" },
        "title": { "type": "string", "description": "Edition title" },
        "subtitle": { "type": "string", "description": "Edition subtitle" },
        "date": { "type": "string", "description": "Ceremony date" },
        "heroImage": { "type": "string", "description": "Banner photo URL" },
        "story": { "type": "string", "description": "Edition story text" },
        "videoUrl": { "type": "string", "description": "Video recording URL" },
        "pageUrl": { "type": "string", "description": "Relative page URL" }
      },
      "required": ["year", "title"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Film festival entry submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Student filmmaker full name" },
        "email": { "type": "string", "description": "Contact email" },
        "age": { "type": "number", "description": "Age 10-18" },
        "category": { "type": "string", "description": "Competition category" },
        "location": { "type": "string", "description": "Country and city" },
        "institution": { "type": "string", "description": "School or film studio" },
        "filmTitle": { "type": "string", "description": "Film title" },
        "deviceModel": { "type": "string", "description": "Phone or tablet model used" },
        "synopsis": { "type": "string", "description": "Film synopsis" },
        "videoUrl": { "type": "string", "description": "Storage URL of the video" },
        "videoDurationSeconds": { "type": "number", "description": "Duration in seconds (max 180)" },
        "status": { "type": "string", "description": "Status (submitted, accepted, semifinal, final, winner, rejected)" },
        "inVoting": { "type": "boolean", "description": "Whether film is active in public voting" },
        "isWinner": { "type": "boolean", "description": "Whether film is an official laureate" },
        "awardTitle": { "type": "string", "description": "Award or nomination title" },
        "votesCount": { "type": "number", "description": "Audience votes counter" }
      },
      "required": ["name", "email", "category", "filmTitle", "videoUrl"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Platform administrator or committee member profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth User UID" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "First name" },
        "surname": { "type": "string", "description": "Last name" },
        "role": { "type": "string", "description": "Role: admin, moderator, judge, accountant, viewer" },
        "status": { "type": "string", "description": "Status: active, suspended, pending" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "lastLogin": { "type": "string", "description": "ISO timestamp of last activity" },
        "invitedBy": { "type": "string", "description": "Admin email who created the invitation" }
      },
      "required": ["email", "role", "status"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Secure access invitation token for committee members",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Unique cryptographic invitation token" },
        "name": { "type": "string", "description": "Invitee first name" },
        "surname": { "type": "string", "description": "Invitee last name" },
        "email": { "type": "string", "description": "Invitee email" },
        "role": { "type": "string", "description": "Assigned role" },
        "code": { "type": "string", "description": "6-character verification code" },
        "status": { "type": "string", "description": "Status: pending, accepted, revoked" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "expiresAt": { "type": "string", "description": "Expiration timestamp" },
        "invitedBy": { "type": "string", "description": "Admin email who issued the invite" }
      },
      "required": ["token", "email", "role", "code", "status"]
    },
    "VoteAudit": {
      "title": "VoteAudit",
      "description": "Audit and rate-limiting document for audience voting per device and category",
      "type": "object",
      "properties": {
        "filmId": { "type": "string", "description": "ID of film voted for" },
        "category": { "type": "string", "description": "Category slug (e.g. cat1 or cat2)" },
        "deviceHash": { "type": "string", "description": "SHA-256 fingerprint hash of voter device" },
        "votedAt": { "type": "string", "description": "Timestamp when vote was cast" }
      },
      "required": ["filmId", "category", "deviceHash"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of administrative actions across the platform",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Action code, e.g. USER_INVITED, USER_DELETED, STATUS_TOGGLED, SETTINGS_CHANGED" },
        "category": { "type": "string", "description": "Action category: users, settings, security, media" },
        "adminEmail": { "type": "string", "description": "Email of admin who executed action" },
        "adminName": { "type": "string", "description": "Name of admin who executed action" },
        "target": { "type": "string", "description": "Target entity or identifier affected" },
        "details": { "type": "string", "description": "Human-readable description of action" },
        "timestamp": { "type": "string", "description": "ISO timestamp of event" },
        "status": { "type": "string", "description": "Execution status: success, warning, error" }
      },
      "required": ["action", "adminEmail", "timestamp"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "FestivalSettings",
      "description": "Global festival settings and tab controls"
    },
    "/editions/{editionId}": {
      "schema": "FestivalEdition",
      "description": "Annual festival edition documents"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Film entries submitted by participants"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Admin and staff user accounts"
    },
    "/invitations/{invitationToken}": {
      "schema": "Invitation",
      "description": "Pending user invitation tokens"
    },
    "/votes_audit/{auditId}": {
      "schema": "VoteAudit",
      "description": "Device vote locks per category"
    },
    "/logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Administrative activity and audit logs"
    }
  }
}
