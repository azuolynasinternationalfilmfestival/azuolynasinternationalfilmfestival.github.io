{
  "entities": {
    "FestivalSettings": {
      "title": "FestivalSettings",
      "description": "Global festival settings, tab visibilities, and localized controls",
      "type": "object",
      "properties": {
        "showAbout": { "type": "boolean", "description": "Visibility of About tab & hero" },
        "showTerms": { "type": "boolean", "description": "Visibility of Terms & rules tab" },
        "showFaq": { "type": "boolean", "description": "Visibility of FAQ tab" },
        "showCategories": { "type": "boolean", "description": "Visibility of Categories & prizes tab" },
        "showEditions": { "type": "boolean", "description": "Visibility of Editions tab" },
        "showArchive": { "type": "boolean", "description": "Visibility of Archive tab" },
        "archiveVisibility": { "type": "boolean", "description": "Global archive visibility tumbler" },
        "showCurrentEdition": { "type": "boolean", "description": "Visibility of featured FEST edition link" },
        "showResults": { "type": "boolean", "description": "Visibility of Results & winners tab" },
        "publicWinners": { "type": "boolean", "description": "Whether public winners are revealed" },
        "showVoting": { "type": "boolean", "description": "Visibility of Voting tab" },
        "votingActive": { "type": "boolean", "description": "Whether voting is active or closed" },
        "votingOpen": { "type": "boolean", "description": "Legacy voting status flag" },
        "showScreening": { "type": "boolean", "description": "Visibility of Screening tab" },
        "showSubmit": { "type": "boolean", "description": "Visibility of Submission form tab" },
        "submissionsOpen": { "type": "boolean", "description": "Whether submissions are open" },
        "maintenanceMode": { "type": "boolean", "description": "Whether maintenance mode is active" },
        "selectedYear": { "type": "string", "description": "Active festival edition year" },
        "recordingVideoUrl": { "type": "string", "description": "URL of the festival recording video" },
        "prizesPhotoUrl": { "type": "string", "description": "URL of the prizes photo" }
      }
    },
    "FestivalEdition": {
      "title": "FestivalEdition",
      "description": "Information and photo album for a specific annual edition of the festival",
      "type": "object",
      "properties": {
        "year": { "type": "string", "description": "Edition year" },
        "status": { "type": "string", "description": "Edition status: upcoming, active, or completed" },
        "title": { "type": "string", "description": "Edition title (LT)" },
        "titleEn": { "type": "string", "description": "Edition title (EN)" },
        "subtitle": { "type": "string", "description": "Edition subtitle (LT)" },
        "subtitleEn": { "type": "string", "description": "Edition subtitle (EN)" },
        "date": { "type": "string", "description": "Ceremony date (LT)" },
        "dateEn": { "type": "string", "description": "Ceremony date (EN)" },
        "heroImage": { "type": "string", "description": "Banner photo URL" },
        "story": { "type": "string", "description": "Edition story text (LT)" },
        "storyEn": { "type": "string", "description": "Edition story text (EN)" },
        "videoUrl": { "type": "string", "description": "Video recording URL" },
        "pageUrl": { "type": "string", "description": "Relative page URL (LT)" },
        "pageUrlEn": { "type": "string", "description": "Relative page URL (EN)" },
        "submissionDeadline": { "type": "string", "description": "Submission deadline ISO date" },
        "categories": { "type": "string", "description": "Competition categories summary (LT)" },
        "categoriesEn": { "type": "string", "description": "Competition categories summary (EN)" },
        "photos": { "type": "array", "description": "Album photo objects with url, captions, and category" }
      },
      "required": ["year", "title"]
    },
    "FestivalContent": {
      "title": "FestivalContent",
      "description": "Unified edition/home content, texts (LT/EN), media links, gallery photos, and SEO fields",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document identifier (e.g. 'home', '2027', '2026', '2028')", "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "year": { "type": "string", "description": "Edition year or 'home'", "maxLength": 16 },
        "status": { "type": "string", "enum": ["upcoming", "active", "completed", "home"], "description": "Publication status" },
        "submissionDeadline": { "type": "string", "description": "Submission deadline YYYY-MM-DD", "maxLength": 32 },
        "title": { "type": "string", "description": "Main title (LT)", "maxLength": 200 },
        "titleEn": { "type": "string", "description": "Main title (EN)", "maxLength": 200 },
        "date": { "type": "string", "description": "Event date text (LT)", "maxLength": 160 },
        "dateEn": { "type": "string", "description": "Event date text (EN)", "maxLength": 160 },
        "theme": { "type": "string", "description": "Festival theme (LT)", "maxLength": 200 },
        "themeEn": { "type": "string", "description": "Festival theme (EN)", "maxLength": 200 },
        "subtitle": { "type": "string", "description": "Subtitle / short summary (LT)", "maxLength": 500 },
        "subtitleEn": { "type": "string", "description": "Subtitle / short summary (EN)", "maxLength": 500 },
        "story": { "type": "string", "description": "Formatted edition story/body (LT)", "maxLength": 25000 },
        "storyEn": { "type": "string", "description": "Formatted edition story/body (EN)", "maxLength": 25000 },
        "heroImage": { "type": "string", "description": "Cover image URL", "maxLength": 2000 },
        "videoUrl": { "type": "string", "description": "Primary ceremony/festival video URL", "maxLength": 2000 },
        "prizesPhotoUrl": { "type": "string", "description": "Statuettes / prizes showcase photo URL (home)", "maxLength": 2000 },
        "videos": { "type": "array", "description": "Archive/retrospective video entries ({title, label, url})" },
        "photos": { "type": "array", "description": "Gallery photo objects ({id, url, caption, captionEn, album})" },
        "seoTitle": { "type": "string", "description": "SEO page title (LT)", "maxLength": 160 },
        "seoTitleEn": { "type": "string", "description": "SEO page title (EN)", "maxLength": 160 },
        "seoDescription": { "type": "string", "description": "SEO meta description (LT)", "maxLength": 400 },
        "seoDescriptionEn": { "type": "string", "description": "SEO meta description (EN)", "maxLength": 400 },
        "pageUrl": { "type": "string", "description": "Resolved LT page URL", "maxLength": 300 },
        "pageUrlEn": { "type": "string", "description": "Resolved EN page URL", "maxLength": 300 },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last edit", "maxLength": 64 },
        "updatedBy": { "type": "string", "description": "Editor email", "maxLength": 200 }
      },
      "required": ["year"]
    },
    "Movie": {
      "title": "Movie",
      "description": "Public showcase film entry for ceremony voting and results",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Film title" },
        "director": { "type": "string", "description": "Director name" },
        "category": { "type": "string", "description": "Competition category" },
        "synopsis": { "type": "string", "description": "Film synopsis" },
        "posterUrl": { "type": "string", "description": "Poster image URL" },
        "videoUrl": { "type": "string", "description": "Film video URL" },
        "votes": { "type": "number", "description": "Audience vote count" },
        "juryPlace": { "type": "number", "description": "Official jury placement" }
      },
      "required": ["title"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Film festival entry submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Student filmmaker full name" },
        "directorFirstName": { "type": "string", "description": "Director first name" },
        "directorLastName": { "type": "string", "description": "Director last name" },
        "cameraOperator": { "type": "string", "description": "Camera operator full name" },
        "ideaAuthor": { "type": "string", "description": "Idea author full name" },
        "screenwriter": { "type": "string", "description": "Screenwriter full name" },
        "email": { "type": "string", "description": "Contact email" },
        "age": { "type": "number", "description": "Age 10-18" },
        "category": { "type": "string", "description": "Competition category" },
        "location": { "type": "string", "description": "Country and city" },
        "institution": { "type": "string", "description": "School or film studio" },
        "filmTitle": { "type": "string", "description": "Film title" },
        "deviceModel": { "type": "string", "description": "Phone or tablet model used" },
        "synopsis": { "type": "string", "description": "Film synopsis" },
        "videoUrl": { "type": "string", "description": "Storage or HTTPS URL of the video" },
        "videoDurationSeconds": { "type": "number", "description": "Duration in seconds (max 180)" },
        "status": { "type": "string", "description": "Status (submitted, accepted, semifinal, final, winner, rejected)" },
        "inVoting": { "type": "boolean", "description": "Whether film is active in public voting" },
        "isWinner": { "type": "boolean", "description": "Whether film is an official laureate" },
        "awardTitle": { "type": "string", "description": "Award or nomination title" },
        "votesCount": { "type": "number", "description": "Audience votes counter" }
      },
      "required": ["email", "filmTitle", "videoUrl"]
    },
    "StreamConfig": {
      "title": "StreamConfig",
      "description": "Public live stream playback configuration (sensitive ingest keys excluded)",
      "type": "object",
      "properties": {
        "iframeUrl": { "type": "string", "description": "Public player iframe URL" },
        "viewPermission": { "type": "string", "description": "token_only, public, or restricted" },
        "streamState": { "type": "string", "description": "Stream status state" },
        "isLive": { "type": "boolean", "description": "Whether broadcast is currently live" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      }
    },
    "LiveViewer": {
      "title": "LiveViewer",
      "description": "Authorized remote festival participant pass for live stream access",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Live pass token" },
        "email": { "type": "string", "description": "Participant email" },
        "name": { "type": "string", "description": "Participant name" },
        "filmTitle": { "type": "string", "description": "Submitted film title" },
        "role": { "type": "string", "description": "Viewer role (remote_participant, teacher, etc.)" },
        "status": { "type": "string", "description": "Access status" }
      },
      "required": ["token", "email", "role", "status"]
    },
    "StreamToken": {
      "title": "StreamToken",
      "description": "Hashed classroom or individual stream access token",
      "type": "object",
      "properties": {
        "tokenType": { "type": "string", "description": "classroom or individual" },
        "label": { "type": "string", "description": "Teacher or viewer display label" },
        "isActive": { "type": "boolean", "description": "Whether token is active" },
        "maxUses": { "type": "number", "description": "Maximum allowed activations" },
        "currentUses": { "type": "number", "description": "Current activation count" },
        "expiresAt": { "type": "string", "description": "Expiration timestamp" }
      },
      "required": ["tokenType", "isActive"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Platform administrator or committee member profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth User UID" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "First name" },
        "surname": { "type": "string", "description": "Last name" },
        "role": { "type": "string", "description": "Role: admin, moderator, judge, accountant, viewer" },
        "status": { "type": "string", "description": "Status: active, suspended, pending" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "lastLogin": { "type": "string", "description": "ISO timestamp of last activity" },
        "invitedBy": { "type": "string", "description": "Admin email who created the invitation" }
      },
      "required": ["email", "role", "status"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Secure access invitation token for committee members",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Unique cryptographic invitation token" },
        "name": { "type": "string", "description": "Invitee first name" },
        "surname": { "type": "string", "description": "Invitee last name" },
        "email": { "type": "string", "description": "Invitee email" },
        "role": { "type": "string", "description": "Assigned role" },
        "code": { "type": "string", "description": "6-character verification code" },
        "status": { "type": "string", "description": "Status: pending, accepted, revoked" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "expiresAt": { "type": "string", "description": "Expiration timestamp" },
        "invitedBy": { "type": "string", "description": "Admin email who issued the invite" }
      },
      "required": ["token", "email", "role", "code", "status"]
    },
    "JudgeEvaluation": {
      "title": "JudgeEvaluation",
      "description": "Jury scorecard for a film submission",
      "type": "object",
      "properties": {
        "filmId": { "type": "string", "description": "Target submission ID" },
        "judgeUid": { "type": "string", "description": "Judge UID or email" },
        "score": { "type": "number", "description": "Assigned total score" },
        "notes": { "type": "string", "description": "Jury feedback notes" }
      },
      "required": ["filmId"]
    },
    "VoteRecord": {
      "title": "VoteRecord",
      "description": "Public audience vote log record",
      "type": "object",
      "properties": {
        "filmId": { "type": "string", "description": "ID of voted film" },
        "filmTitle": { "type": "string", "description": "Title of voted film" },
        "collection": { "type": "string", "description": "Source collection (submissions or movies)" },
        "votedAt": { "type": "string", "description": "Timestamp of vote" }
      },
      "required": ["filmId"]
    },
    "VoteAudit": {
      "title": "VoteAudit",
      "description": "Audit and rate-limiting document for audience voting per device and category",
      "type": "object",
      "properties": {
        "filmId": { "type": "string", "description": "ID of film voted for" },
        "category": { "type": "string", "description": "Category slug (e.g. cat1 or cat2)" },
        "deviceHash": { "type": "string", "description": "SHA-256 fingerprint hash of voter device" },
        "votedAt": { "type": "string", "description": "Timestamp when vote was cast" }
      },
      "required": ["filmId", "category"]
    },
    "AdminTask": {
      "title": "AdminTask",
      "description": "Internal committee workflow task",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Task title" },
        "status": { "type": "string", "description": "Task status" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of administrative actions across the platform",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Action code, e.g. USER_INVITED, USER_DELETED, STATUS_TOGGLED, SETTINGS_CHANGED" },
        "category": { "type": "string", "description": "Action category: users, settings, security, media" },
        "adminEmail": { "type": "string", "description": "Email of admin who executed action" },
        "adminName": { "type": "string", "description": "Name of admin who executed action" },
        "target": { "type": "string", "description": "Target entity or identifier affected" },
        "details": { "type": "string", "description": "Human-readable description of action" },
        "timestamp": { "type": "string", "description": "ISO timestamp of event" },
        "status": { "type": "string", "description": "Execution status: success, warning, error" }
      },
      "required": ["action", "timestamp"]
    },
    "MailMessage": {
      "title": "MailMessage",
      "description": "Trigger Email extension dispatch queue item",
      "type": "object",
      "properties": {
        "to": { "type": "array", "description": "Recipient email address(es)" },
        "message": { "type": "object", "description": "Subject, html, and text payload" },
        "from": { "type": "string", "description": "Sender address" },
        "replyTo": { "type": "string", "description": "Reply-to address" },
        "createdAt": { "type": "string", "description": "ISO timestamp of message creation" }
      },
      "required": ["to", "message"]
    }
  },
  "firestore": {
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Showcase films for voting and ceremony podium"
    },
    "/settings/{settingId}": {
      "schema": "FestivalSettings",
      "description": "Global festival settings and tab controls"
    },
    "/editions/{editionId}": {
      "schema": "FestivalEdition",
      "description": "Annual festival edition documents"
    },
    "/content/{contentId}": {
      "schema": "FestivalContent",
      "description": "Unified festival content (editions by year and home page archive/SEO data)"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Film entries submitted by participants"
    },
    "/stream_config/{configId}": {
      "schema": "StreamConfig",
      "description": "Live broadcast configuration"
    },
    "/live_viewers/{viewerId}": {
      "schema": "LiveViewer",
      "description": "Remote participant stream access records"
    },
    "/stream_tokens/{tokenHash}": {
      "schema": "StreamToken",
      "description": "Hashed teacher and viewer live access tokens"
    },
    "/votes/{voteId}": {
      "schema": "VoteRecord",
      "description": "Audience vote records"
    },
    "/votes_audit/{auditId}": {
      "schema": "VoteAudit",
      "description": "Device vote locks per category"
    },
    "/tasks/{taskId}": {
      "schema": "AdminTask",
      "description": "Committee management tasks"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Admin and staff user accounts"
    },
    "/invitations/{invitationToken}": {
      "schema": "Invitation",
      "description": "Pending user invitation tokens"
    },
    "/judge_evaluations/{evaluationId}": {
      "schema": "JudgeEvaluation",
      "description": "Jury film evaluations"
    },
    "/mail/{mailId}": {
      "schema": "MailMessage",
      "description": "Trigger Email queue documents"
    },
    "/logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Administrative activity and audit logs"
    }
  }
}
