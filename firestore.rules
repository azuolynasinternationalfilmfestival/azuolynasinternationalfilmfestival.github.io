rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Level Administrator (Full Management):
    // azuolynasfilmfestival@gmail.com has complete administrative control.
    // Also recognizes co-admin karina.brdar@gmail.com and active admin role in users/{uid}.
    // Admin email allow-list: strictly enforced via Firebase Auth email claim
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
         request.auth.token.email.lower() == 'karina.brdar@gmail.com');
    }

    // Dedicated Judge Role: Evaluation & read-only permissions for applications
    function isJudge() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'judge' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Festival Settings: Public read, Super Admin full control & trusted server sync
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // 2. Festival Editions: Public read, Super Admin full control
    match /editions/{editionId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // 3. Submissions: Public creation & read, public voting increment, Super Admin full write/edit/delete
    match /submissions/{submissionId} {
      // Public, Judges, and Super Admins have read access
      allow get, list: if true;

      // Public creation of contest applications
      allow create: if true;

      // Strict update access: Super Admins can update any field;
      // Public audience can only increment votesCount by exactly +1
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['votesCount']) &&
        incoming().votesCount == (existing().get('votesCount', 0) + 1)
      );

      // Full deletion access for Super Admins
      allow delete: if isSuperAdmin();
    }

    // 4. Stream Configuration: Public read, Super Admin write
    match /stream_config/{configId} {
      allow get, list: if true;
      allow write: if isSuperAdmin() || (
        incoming().adminEmail != null && (
          incoming().adminEmail.lower() == 'azuolynasfilmfestival@gmail.com' ||
          incoming().adminEmail.lower() == 'karina.brdar@gmail.com'
        )
      );
    }

    // 5. Live Stream Viewers / Tokens: Public token access, Super Admin full control
    match /live_viewers/{viewerId} {
      allow get: if true;
      allow list: if isSuperAdmin() || isJudge();
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // 5b. Stream Hashed Tokens: Public verification get, Super Admin full control
    match /stream_tokens/{tokenHash} {
      allow get: if true;
      allow list, create, update, delete: if isSuperAdmin();
    }

    // 5c. Public Voting: 1 vote per person per nomination enforced by doc ID = nominationId_uid
    match /votes/{voteId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().nominationId != null &&
        incoming().filmId != null &&
        voteId == (incoming().nominationId + '_' + request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    // 6. Tasks Management (Deprecated - Super Admin only)
    match /tasks/{taskId} {
      allow read, write: if isSuperAdmin();
    }

    // 8. User Accounts (RBAC):
    // Super admin has full control; verified users can edit their own profile data
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() || (
        isSignedIn() && (
          userId == request.auth.uid ||
          (resource != null && resource.data.email == request.auth.token.email)
        )
      );
      allow delete: if isSuperAdmin();
    }

    // 9. Committee Invitations: Super admin management, invited users activate
    match /invitations/{invitationToken} {
      allow get: if true;
      allow list, create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isSignedIn();
    }

    // 10. Judge Evaluations: Dedicated evaluation permissions for Judges & Super Admin
    match /judge_evaluations/{evaluationId} {
      allow get, list: if isSuperAdmin() || isJudge();
      allow create, update: if isJudge() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 11. Mail Queue: Public creation of email trigger tasks + Trigger Email delivery update rights
    match /mail/{mailId} {
      allow get, list: if isSuperAdmin();
      allow create, update: if true; // Public trigger & Trigger Email extension delivery updates
      allow delete: if isSuperAdmin();
    }

    // 12. Administrative Activity Logs
    match /logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }
  }
}
