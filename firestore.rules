rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Verified superadmin allowlist (requires email_verified == true) or active admin profile
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null &&
         request.auth.token.email_verified == true &&
         (request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
          request.auth.token.email.lower() == 'karina.brdar@gmail.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    // Dedicated Judge Role: Evaluation & read-only permissions for applications
    function isJudge() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'judge' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmail(val) {
      return val is string && val.size() >= 3 && val.size() <= 200;
    }

    function isValidId(val) {
      return val is string && val.size() >= 1 && val.size() <= 64 && val.matches('^[A-Za-z0-9_-]+$');
    }

    function isOptString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidFestivalContent(data) {
      return data.keys().hasAll(['year']) &&
        data.year is string && data.year.size() >= 1 && data.year.size() <= 16 &&
        isOptString(data, 'id', 64) &&
        (!('status' in data) || data.status in ['upcoming', 'active', 'completed', 'home']) &&
        isOptString(data, 'submissionDeadline', 32) &&
        isOptString(data, 'title', 200) &&
        isOptString(data, 'titleEn', 200) &&
        isOptString(data, 'date', 160) &&
        isOptString(data, 'dateEn', 160) &&
        isOptString(data, 'theme', 200) &&
        isOptString(data, 'themeEn', 200) &&
        isOptString(data, 'subtitle', 500) &&
        isOptString(data, 'subtitleEn', 500) &&
        isOptString(data, 'story', 25000) &&
        isOptString(data, 'storyEn', 25000) &&
        isOptString(data, 'heroImage', 2000) &&
        isOptString(data, 'videoUrl', 2000) &&
        isOptString(data, 'prizesPhotoUrl', 2000) &&
        isOptString(data, 'seoTitle', 160) &&
        isOptString(data, 'seoTitleEn', 160) &&
        isOptString(data, 'seoDescription', 400) &&
        isOptString(data, 'seoDescriptionEn', 400) &&
        isOptString(data, 'pageUrl', 300) &&
        isOptString(data, 'pageUrlEn', 300) &&
        isOptString(data, 'updatedAt', 64) &&
        isOptString(data, 'updatedBy', 200) &&
        (!('videos' in data) || (data.videos is list && data.videos.size() <= 50)) &&
        (!('photos' in data) || (data.photos is list && data.photos.size() <= 200));
    }

    // 0. Movies Collection: Public read, atomic increment of +1 on 'votes', admin controls rest
    match /movies/{movieId} {
      allow get, list: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['votes']) &&
        incoming().votes is int &&
        incoming().votes == existing().get('votes', 0) + 1
      );
    }

    // 1. Festival Settings: Public read, Super Admin full write
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // 2. Festival Editions (Legacy fallback): Public read, Super Admin full write
    match /editions/{editionId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // 2b. Unified Festival Content: Public read, Super Admin validated write
    match /content/{contentId} {
      allow get, list: if true;
      allow create, update: if isSuperAdmin() && isValidId(contentId) && isValidFestivalContent(incoming());
      allow delete: if isSuperAdmin() && isValidId(contentId);
    }

    // 3. Submissions:
    //    - Public queries restricted strictly to films in voting or official winners (protects applicant PII)
    //    - Judges & Super Admins may read full roster
    //    - Applicants may create initial submitted entries (validated schema, immutable admin flags)
    //    - Audience may increment votesCount or votes by +1
    match /submissions/{submissionId} {
      allow get, list: if isSuperAdmin() || isJudge() ||
        resource.data.inVoting == true ||
        resource.data.isWinner == true;

      allow create: if isSuperAdmin() || (
        incoming().keys().hasAll(['filmTitle', 'email']) &&
        incoming().filmTitle is string && incoming().filmTitle.size() > 0 && incoming().filmTitle.size() <= 200 &&
        isValidEmail(incoming().email) &&
        (!('status' in incoming()) || incoming().status == 'submitted') &&
        (!('inVoting' in incoming()) || incoming().inVoting == false) &&
        (!('isWinner' in incoming()) || incoming().isWinner == false) &&
        (!('votesCount' in incoming()) || incoming().votesCount == 0)
      );

      allow update: if isSuperAdmin() || (
        (incoming().diff(existing()).affectedKeys().hasOnly(['votesCount']) &&
         incoming().votesCount is int &&
         incoming().votesCount == existing().get('votesCount', 0) + 1) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['votes']) &&
         incoming().votes is int &&
         incoming().votes == existing().get('votes', 0) + 1)
      );

      allow delete: if isSuperAdmin();

      match /votes/{voteUid} {
        allow get: if isSuperAdmin() || (isSignedIn() && request.auth.uid == voteUid);
        allow list: if isSuperAdmin();
        allow create: if isSignedIn() && request.auth.uid == voteUid;
        allow update, delete: if isSuperAdmin();
      }
    }

    // 4. Stream Configuration: Public read of playback state, Super Admin write only
    match /stream_config/{configId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
    }

    // 5. Live Stream Viewers / Tokens: Individual token get, admin/judge list, validated remote pass creation
    match /live_viewers/{viewerId} {
      allow get: if true;
      allow list: if isSuperAdmin() || isJudge();
      allow create: if isSuperAdmin() || (
        incoming().keys().hasAll(['token', 'email', 'filmTitle', 'role', 'status']) &&
        incoming().token is string && incoming().token.size() >= 8 && incoming().token.size() <= 160 &&
        isValidEmail(incoming().email) &&
        incoming().role == 'remote_participant' &&
        incoming().status == 'authorized'
      );
      allow update, delete: if isSuperAdmin();
    }

    // 5b. Stream Hashed Tokens: Public verification get by hash, Super Admin management
    match /stream_tokens/{tokenHash} {
      allow get: if true;
      allow list, create, update, delete: if isSuperAdmin();
    }

    // 5c. Public Voting Log & Audit
    match /votes/{voteId} {
      allow get, list: if isSuperAdmin() || isJudge();
      allow create: if isSuperAdmin() || (
        incoming().filmId is string && incoming().filmId.size() > 0 && incoming().filmId.size() <= 128 &&
        incoming().votedAt != null && (
          (isSignedIn() &&
           'userId' in incoming() &&
           incoming().userId == request.auth.uid &&
           'nominationId' in incoming() &&
           incoming().nominationId is string &&
           voteId == (incoming().nominationId + '_' + request.auth.uid)) ||
          !('userId' in incoming())
        )
      );
      allow update, delete: if isSuperAdmin();
    }

    match /votes_audit/{auditId} {
      allow get, list: if isSuperAdmin() || isJudge();
      allow create: if isSuperAdmin() || (
        incoming().keys().hasAll(['filmId', 'category']) &&
        incoming().filmId is string && incoming().filmId.size() > 0 &&
        incoming().category is string && incoming().category.size() > 0
      );
      allow update, delete: if isSuperAdmin();
    }

    // 6. Tasks Management (Super Admin only)
    match /tasks/{taskId} {
      allow read, write: if isSuperAdmin();
    }

    // 8. User Accounts (RBAC): Prevent client-side privilege escalation
    match /users/{userId} {
      allow get: if isSuperAdmin() || (
        isSignedIn() && (
          userId == request.auth.uid ||
          (resource != null && resource.data.email == request.auth.token.email)
        )
      );
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        userId == request.auth.uid &&
        incoming().role == 'viewer'
      );
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        userId == request.auth.uid &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'status', 'canManageUsers', 'permissions'])
      );
      allow delete: if isSuperAdmin();
    }

    // 9. Committee Invitations: Super admin management, signed-in invitee activation only
    match /invitations/{invitationToken} {
      allow get: if true;
      allow list, create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        existing().status == 'pending' &&
        incoming().status == 'accepted' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt', 'uid'])
      );
    }

    // 10. Judge Evaluations: Dedicated evaluation permissions for Judges & Super Admin
    match /judge_evaluations/{evaluationId} {
      allow get, list: if isSuperAdmin() || isJudge();
      allow create, update: if isJudge() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 11. Mail Queue: Schema-validated creation for Trigger Email, Super Admin read/manage
    match /mail/{mailId} {
      allow get, list, update, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (
        incoming().keys().hasAll(['to', 'message']) &&
        incoming().to is list && incoming().to.size() > 0 && incoming().to.size() <= 10 &&
        incoming().message is map &&
        incoming().message.subject is string && incoming().message.subject.size() > 0 &&
        incoming().message.html is string && incoming().message.html.size() > 0
      );
    }

    // 12. Administrative Activity Logs
    match /logs/{logId} {
      allow get, list, update, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (
        incoming().keys().hasAll(['action', 'timestamp']) &&
        incoming().action is string && incoming().action.size() > 0 && incoming().action.size() <= 100
      );
    }
  }
}
