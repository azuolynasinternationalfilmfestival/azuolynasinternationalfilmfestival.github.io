rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWhitelistedAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
          request.auth.token.email.lower() == 'karina.brdar@gmail.com' ||
          request.auth.token.email.lower() == 'dominikphotofficial.lt@gmail.com' ||
          request.auth.token.email.lower() == 'dominikcute4@gmail.com'
        );
    }

    function isAdmin() {
      return isWhitelistedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // 1. Festival Settings
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isWhitelistedAdmin() || isAdmin();
    }

    // 2. Festival Editions
    match /editions/{editionId} {
      allow get, list: if true;
      allow write: if isWhitelistedAdmin() || isAdmin();
    }

    // 3. Submissions
    match /submissions/{submissionId} {
      // Allow read for everyone (public listing of entries/winners/voting and admin dashboard)
      allow get, list: if true;

      // Public can create submissions (validated fields)
      allow create: if (isWhitelistedAdmin() || isAdmin() || isStaff()) || (
        isValidId(submissionId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 150 &&
        incoming().filmTitle is string && incoming().filmTitle.size() > 0 && incoming().filmTitle.size() <= 200 &&
        incoming().videoUrl is string && incoming().videoUrl.size() > 0 && incoming().videoUrl.size() <= 1000 &&
        incoming().status == 'submitted' &&
        incoming().inVoting == false &&
        incoming().votesCount == 0
      );

      // Admins and Staff can update all fields (status, inVoting, live token, etc.)
      // Unauthenticated audience / voters can ONLY increment votesCount by exactly +1
      allow update: if isWhitelistedAdmin() || isAdmin() || isStaff() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['votesCount']) &&
        incoming().votesCount == (existing().get('votesCount', 0) + 1)
      );

      allow delete: if isWhitelistedAdmin() || isAdmin();

      // Votes subcollection
      match /votes/{voterId} {
        allow get: if isValidId(voterId);
        allow list: if isStaff() || isWhitelistedAdmin() || isAdmin();
        allow create, update: if isValidId(voterId);
        allow delete: if isWhitelistedAdmin() || isAdmin();
      }
    }

    // 4. Stream Configuration
    match /stream_config/{configId} {
      allow get, list: if true;
      allow write: if isWhitelistedAdmin() || isAdmin();
    }

    // 5. Live Stream Viewers / Tokens
    match /live_viewers/{viewerId} {
      allow get: if isValidId(viewerId);
      allow list: if isWhitelistedAdmin() || isAdmin();
      allow create, update: if isValidId(viewerId);
      allow delete: if isWhitelistedAdmin() || isAdmin();
    }

    // 6. Tasks Management
    match /tasks/{taskId} {
      allow get, list: if isWhitelistedAdmin() || isStaff() || isAdmin();
      allow write: if isWhitelistedAdmin() || isStaff() || isAdmin();
    }

    // 7. Global Anti-Fraud Vote Audit
    match /votes_audit/{auditId} {
      allow get: if isValidId(auditId);
      allow list: if isStaff() || isWhitelistedAdmin() || isAdmin();
      allow create: if isValidId(auditId) &&
        incoming().filmId is string &&
        incoming().category is string &&
        incoming().deviceHash is string;
      allow update, delete: if isWhitelistedAdmin() || isAdmin();
    }

    // 8. User Accounts (RBAC)
    match /users/{userId} {
      allow get: if isWhitelistedAdmin() || isAdmin() || (isSignedIn() &&
        (userId == request.auth.uid || existing().email == request.auth.token.email));
      allow list: if isWhitelistedAdmin() || isAdmin();
      allow create: if isWhitelistedAdmin() || isAdmin() || (isSignedIn() && userId == request.auth.uid);
      allow update: if isWhitelistedAdmin() || isAdmin() || (isSignedIn() && userId == request.auth.uid);
      allow delete: if isWhitelistedAdmin() || isAdmin();
    }

    // 9. Committee Invitations
    match /invitations/{invitationToken} {
      allow get: if isValidId(invitationToken);
      allow list, create, delete: if isWhitelistedAdmin() || isAdmin();
      allow update: if isWhitelistedAdmin() || isAdmin() || (isSignedIn() &&
        existing().status == 'pending' && existing().email == request.auth.token.email &&
        incoming().status == 'activated' && incoming().activatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'activatedBy', 'activatedAt']));
    }

    // 10. Judge Evaluations
    match /judge_evaluations/{evaluationId} {
      allow get, list: if isStaff() || isWhitelistedAdmin() || isAdmin();
      allow create: if (isStaff() || isWhitelistedAdmin() || isAdmin()) && incoming().judgeEmail == request.auth.token.email;
      allow update: if (isStaff() || isWhitelistedAdmin() || isAdmin()) && existing().judgeEmail == request.auth.token.email &&
        incoming().judgeEmail == existing().judgeEmail;
      allow delete: if isWhitelistedAdmin() || isAdmin();
    }

    // 11. Trigger Email Queue: MUST allow update for extension delivery recording!
    match /mail/{mailId} {
      allow get, list: if isWhitelistedAdmin() || isAdmin() || isStaff();
      allow create: if isValidId(mailId);
      allow update: if true; // Būtina: Trigger Email plėtinys po išsiuntimo įrašo `delivery` objektą!
      allow delete: if isWhitelistedAdmin() || isAdmin();
    }

    // 12. Administrative Activity Logs
    match /logs/{logId} {
      allow get, list: if isWhitelistedAdmin() || isAdmin();
      allow write: if isWhitelistedAdmin() || isAdmin();
    }
  }
}
