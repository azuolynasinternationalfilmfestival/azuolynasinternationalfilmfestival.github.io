rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
        request.auth.token.email.lower() == 'karina.brdar@gmail.com' ||
        request.auth.token.email.lower() == 'dominikphotofficial.lt@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Festival Settings
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin();
    }

    // Festival Editions
    match /editions/{editionId} {
      allow read: if isValidId(editionId);
      allow write: if isAdmin();
    }

    // Submissions
    match /submissions/{submissionId} {
      // Admins can read all; public can read films that are in voting or winners
      allow get: if isValidId(submissionId) && (
        isAdmin() ||
        resource.data.inVoting == true ||
        resource.data.isWinner == true
      );

      allow list: if isAdmin() || (
        resource.data.inVoting == true ||
        resource.data.isWinner == true
      );

      // Public can submit new films
      allow create: if isValidId(submissionId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 150 &&
        incoming().filmTitle is string && incoming().filmTitle.size() > 0 && incoming().filmTitle.size() <= 200 &&
        incoming().videoUrl is string && incoming().videoUrl.size() > 0 && incoming().videoUrl.size() <= 1000 &&
        incoming().status == 'submitted' &&
        incoming().inVoting == false &&
        incoming().votesCount == 0;

      // Admins can update any field; audience can increment votesCount
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['votesCount']) &&
        incoming().votesCount == existing().votesCount + 1
      );

      allow delete: if isAdmin();

      // Votes subcollection for audit
      match /votes/{voterId} {
        allow read: if isAdmin();
        allow create, update: if isValidId(voterId);
      }
    }

    // Mail queue for notifications
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isValidId(mailId);
    }
  }
}
