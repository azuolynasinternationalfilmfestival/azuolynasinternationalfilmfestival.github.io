rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isWhitelistedAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'azuolynasfilmfestival@gmail.com' ||
          request.auth.token.email.lower() == 'karina.brdar@gmail.com' ||
          request.auth.token.email.lower() == 'dominikphotofficial.t@gmail.com' ||
          request.auth.token.email.lower() == 'dominikphotofficial.lt@gmail.com'
        );
    }

    function isAdmin() {
      return isWhitelistedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Festival Settings
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin();
    }

    // Festival Editions
    match /editions/{editionId} {
      allow read: if isValidId(editionId);
      allow write: if isAdmin();
    }

    // Submissions
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && (
        isStaff() ||
        resource.data.inVoting == true ||
        resource.data.isWinner == true
      );

      allow list: if isStaff() || (
        resource.data.inVoting == true ||
        resource.data.isWinner == true
      );

      // Public can submit new films
      allow create: if isValidId(submissionId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 150 &&
        incoming().filmTitle is string && incoming().filmTitle.size() > 0 && incoming().filmTitle.size() <= 200 &&
        incoming().videoUrl is string && incoming().videoUrl.size() > 0 && incoming().videoUrl.size() <= 1000 &&
        incoming().status == 'submitted' &&
        incoming().inVoting == false &&
        incoming().votesCount == 0;

      // Admins and staff can update; audience can increment votesCount
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['votesCount']) &&
        incoming().votesCount == (existing().get('votesCount', 0) + 1)
      );

      allow delete: if isAdmin();

      // Votes subcollection for film audit
      match /votes/{voterId} {
        allow get: if isValidId(voterId);
        allow list: if isStaff();
        allow create, update: if isValidId(voterId);
      }
    }

    // Stream Configuration (Cloudflare Stream & Status)
    match /stream_config/{configId} {
      allow read: if isValidId(configId);
      allow write: if isAdmin();
    }

    // Live Stream Viewers / Tokens
    match /live_viewers/{viewerId} {
      allow get: if isValidId(viewerId);
      allow create, update: if isValidId(viewerId);
      allow list, delete: if isAdmin();
    }

    // Tasks Management
    match /tasks/{taskId} {
      allow read, write: if isStaff() || isAdmin();
    }

    // Global Anti-Fraud Vote Audit: locks 1 vote per category per device
    match /votes_audit/{auditId} {
      allow get: if isValidId(auditId);
      allow list: if isStaff();
      allow create: if isValidId(auditId) &&
        incoming().filmId is string &&
        incoming().category is string &&
        incoming().deviceHash is string;
      allow update, delete: if isAdmin();
    }

    // User accounts: admins manage access; invited users can activate their own profile.
    function hasValidInvitation() {
      let invitation = get(/databases/$(database)/documents/invitations/$(incoming().invitationToken));
      return isSignedIn() && invitation.data.status == 'pending' &&
        invitation.data.email == request.auth.token.email &&
        invitation.data.expiresAt > request.time &&
        incoming().email == invitation.data.email &&
        incoming().role == invitation.data.role &&
        incoming().status == 'active' &&
        incoming().canManageUsers == invitation.data.canManageUsers;
    }

    function hasLegacyProfile() {
      let member = get(/databases/$(database)/documents/users/$(incoming().sourceProfileId));
      return member.data.email == request.auth.token.email && member.data.status == 'active' &&
        incoming().email == member.data.email && incoming().role == member.data.role &&
        incoming().status == 'active' && incoming().uid == request.auth.uid &&
        incoming().keys().hasOnly(['uid', 'email', 'role', 'status', 'lastLogin', 'sourceProfileId']);
    }

    match /users/{userId} {
      allow get: if isWhitelistedAdmin() || (isSignedIn() &&
        (userId == request.auth.uid || existing().email == request.auth.token.email));
      allow list, delete: if isWhitelistedAdmin();
      allow create: if isWhitelistedAdmin() || (isSignedIn() && userId == request.auth.uid &&
        incoming().keys().hasOnly(['uid', 'email', 'name', 'surname', 'role', 'status',
          'canManageUsers', 'invitationToken', 'updatedAt']) &&
        incoming().uid == request.auth.uid && 'invitationToken' in incoming() && hasValidInvitation()) ||
        (isSignedIn() && userId == request.auth.uid && 'sourceProfileId' in incoming() && hasLegacyProfile());
      allow update: if isWhitelistedAdmin() || (isSignedIn() && userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'name', 'surname', 'updatedAt']));
    }

    match /invitations/{invitationToken} {
      allow get: if isValidId(invitationToken);
      allow list, create, delete: if isWhitelistedAdmin();
      allow update: if isWhitelistedAdmin() || (isSignedIn() &&
        existing().status == 'pending' && existing().email == request.auth.token.email &&
        existing().expiresAt > request.time &&
        incoming().status == 'activated' && incoming().activatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'activatedBy', 'activatedAt']));
    }

    match /judge_evaluations/{evaluationId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().judgeEmail == request.auth.token.email;
      allow update: if isStaff() && existing().judgeEmail == request.auth.token.email &&
        incoming().judgeEmail == existing().judgeEmail;
      allow delete: if isAdmin();
    }

    // Mail queue for automated notifications
    match /mail/{mailId} {
      allow read: if isStaff();
      allow create: if isValidId(mailId);
      allow delete: if isAdmin();
    }

    // Administrative Activity Logs - Strictly permitted for azuolynasfilmfestival@gmail.com or whitelisted admin emails
    match /logs/{logId} {
      allow read, write: if isWhitelistedAdmin();
    }
  }
}
